# Polymarket Trading Bot Configuration
# Copy this file to .env and fill in your values

# ===========================================
# API Configuration
# ===========================================

# Polymarket Gamma API URL (default: https://gamma-api.polymarket.com)
GAMMA_API_URL=https://gamma-api.polymarket.com

# Polymarket CLOB API URL (default: https://clob.polymarket.com)
CLOB_API_URL=https://clob.polymarket.com

# Polymarket Data API URL (for redeemable positions; default: https://data-api.polymarket.com)
DATA_API_URL=https://data-api.polymarket.com

# ===========================================
# Trading Strategy Parameters
# ===========================================

# Market to trade (BTC or SOL)
# BTC = Bitcoin Up/Down 15-minute markets
# SOL = Solana Up/Down 15-minute markets
MARKET_TYPE=BTC

# Starting balance for paper trading (in USD)
INITIAL_BALANCE=10000

# Minimum expected return per position (in USD)
# Position must return at least this amount to be considered profitable
MIN_EXPECTED_RETURN=210

# Investment amount per position (in USD)
INVESTMENT_PER_POSITION=100

# Minimum profit required per position (in USD)
MIN_PROFIT=110

# ===========================================
# Bot Configuration
# ===========================================

# Data polling interval in milliseconds (default: 5000 = 5 seconds)
POLL_INTERVAL=5000

# Maximum time to wait for market resolution in milliseconds (default: 600000 = 10 minutes)
MAX_RESOLUTION_WAIT=600000

# Resolution polling interval in milliseconds (default: 30000 = 30 seconds)
RESOLUTION_POLL_INTERVAL=30000

# Minimum time elapsed in market before bot considers it "mid-market" (in milliseconds)
# Default: 120000 = 2 minutes
MIN_TIME_TO_START=120000

# ===========================================
# File Paths
# ===========================================

# Portfolio data file (stores paper trading positions and balance)
PORTFOLIO_FILE=./data/portfolio.json
STRATEGY_RESULTS_FILE=./data/strategy-results.json

# Live trading data files (auto-selected when LIVE_TRADING_ENABLED=true)
PORTFOLIO_FILE_LIVE=./data/portfolio-live.json
STRATEGY_RESULTS_FILE_LIVE=./data/strategy-results-live.json

# ===========================================
# Live Trading Configuration
# ===========================================

# Enable live trading mode (default: false = paper trading)
# WARNING: Set to true only after testing in dry-run mode!
LIVE_TRADING_ENABLED=false

# Wallet Private Key (REQUIRED for live trading)
# Export from your wallet (must start with 0x)
# POLYGON_PRIVATE_KEY=0x...

# Dry-run mode (default: false)
# When true: Orders are signed but NOT submitted (safe testing)
# When false: Orders ARE submitted to Polymarket (real money)
DRY_RUN_MODE=true

# Position size for live trading (in USD)
# This is the exact amount spent per position
# Start small for testing, then scale up
POSITION_SIZE=1

# Minimum expected return for live trading (in USD)
# Scale with position size (e.g., $2.10 for $1 positions = 110% ROI)
MIN_EXPECTED_RETURN_LIVE=2.10

# Signature type (0 = EOA wallet, 1 = Email/Magic, 2 = Browser Wallet)
SIGNATURE_TYPE=0

# Verbose logging (shows all OrderManager details)
VERBOSE_LOGGING=false

# Auto-redeem: when true, bot automatically redeems winning positions on an interval
# Requires LIVE_TRADING_ENABLED=true
AUTO_REDEEM_ENABLED=false

# Auto-redeem interval in minutes (default: 60)
# First run happens 30 seconds after stream starts, then every N minutes
AUTO_REDEEM_INTERVAL_MINUTES=60

# RPC URL for Polygon network (optional)
# RPC_URL=https://polygon-rpc.com

# ===========================================
# WebSocket Configuration (Phase 3)
# ===========================================

# Enable real-time WebSocket price updates (default: true)
# When enabled, bot receives instant price updates instead of polling
# Falls back to HTTP polling if WebSocket disconnects
WEBSOCKET_ENABLED=true

# WebSocket cache staleness threshold in milliseconds (default: 5000 = 5 seconds)
# If cached price is older than this, fall back to HTTP
WEBSOCKET_STALE_THRESHOLD=5000

